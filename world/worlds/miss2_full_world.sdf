<?xml version="1.0" ?>
<sdf version="1.6">
<world name="miss2_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5 1</ambient_light>
        <background_color>0.8 0.8 0.8 1</background_color>
        <camera_pose>-5 0 5 0 0.5 0</camera_pose>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Load Environment GLB -->
    <include>
      <uri>model://miss2_env</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Load Stock ArduPilot Iris Drone -->
    <include>
      <uri>model://qr_markers</uri>
    </include>
    <include>
      <uri>model://iris_miss2_full</uri>
      <pose>0 -36.50 0.35 0 0 1.5708</pose>
    </include>

  
    <!-- Required for Camera Rendering & Publishing -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>



    <!-- ===================================================== -->
    <!-- GREEN AEROTHON BANNER                                 -->
    <!-- Used by shhhh HybridBannerDetector                    -->
    <!-- ===================================================== -->

    <model name="green_banner">

      <static>true</static>

      <!-- 1 m tall banner: lower edge at 10 ft (3.048 m world Z). -->
      <pose>-4 -30 3.548 0 0 0</pose>

      <link name="banner_link">

        <visual name="banner_visual">

          <geometry>
            <box>
              <size>3.5 0.08 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>

        </visual>

      </link>

    </model>

    <!-- Orange corridor entrance from the payload/coverage field side.
         Match the green banner's dimensions and 10 ft lower-edge height.
         The right-hand corridor centre is world X=4.101 m; its field end
         is world Y=-20.109 m. Like the green banner, place the panel just
         inside the opening and leave it visual-only. -->
    <model name="orange_banner">
      <static>true</static>
      <pose>4.1 -20 3.548 0 0 0</pose>
      <link name="banner_link">
        <visual name="banner_visual">
          <geometry>
            <box>
              <size>3.5 0.08 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Coverage field is the flat Final grd mesh: local N=[-20,20],
         E=[-15,15]. Full-world SITL LOCAL_POSITION_NED aligns with world
         north/east here (not displacement from the spawn at Y=-36.5).
         These paint-only zones
         are deliberately beyond the corridor, with no collision volume. -->
    <model name="coverage_red_zone_1">
      <static>true</static>
      <pose>-3 -7.5 0.095 0 0 0</pose>
      <link name="paint">
        <visual name="red">
          <geometry><box><size>2 3 0.02</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="coverage_red_zone_2">
      <static>true</static>
      <pose>7 9.5 0.095 0 0 0</pose>
      <link name="paint">
        <visual name="red">
          <geometry><box><size>2 3 0.02</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The GLB's central red-ground mesh has a dark/unrendered interior in
         Ogre2 at the coverage-camera viewpoint. A paint-only surface at the
         same surveyed bounds keeps the simulated red zone visible; it adds no
         collision, and the controller receives no zone coordinates. -->
    <model name="coverage_red_zone_central_paint">
      <static>true</static>
      <pose>-1.395 2.75 0.10 0 0 0</pose>
      <link name="paint">
        <visual name="red">
          <geometry><box><size>7.43 10.0 0.02</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Ogre2 renders two long strips of the GLB's otherwise grassy Final grd
         nearly black in the downward camera (verified at N=15, E=8.5). They
         leave >6,000 physically ordinary field cells unobservable even after
         a full sweep. These paint-only grass backings are above the ground
         mesh but below the existing red paint and QR meshes. No collision or
         map coordinates are given to the flight controller. -->
    <model name="coverage_grass_backing_east">
      <static>true</static>
      <pose>8.55 14.35 0.08 0 0 0</pose>
      <link name="paint">
        <visual name="grass">
          <geometry><box><size>4.1 11.3 0.01</size></box></geometry>
          <material><ambient>0.18 0.42 0.12 1</ambient><diffuse>0.18 0.42 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="coverage_grass_backing_west">
      <static>true</static>
      <pose>-8.55 14.5 0.08 0 0 0</pose>
      <link name="paint">
        <visual name="grass">
          <geometry><box><size>4.1 11.0 0.01</size></box></geometry>
          <material><ambient>0.18 0.42 0.12 1</ambient><diffuse>0.18 0.42 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

</world>
</sdf>
